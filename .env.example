# ===== 搜索引擎 API（用于反爬校的全网检索核实） =====
# 三选一：serpapi | bing | google
SEARCH_PROVIDER=serpapi

# 对应 provider 的 API Key
#   serpapi : https://serpapi.com (注册即得，免费 100 次/月，每日全量不够，建议作为兜底)
#   bing    : Azure Bing Web Search（免费 1000 次/月，最适合每日全量）
#   google  : Google Custom Search JSON API（免费 100 次/天，需建 CSE）
SEARCH_API_KEY=

# ===== EdgeOne 部署（从 EdgeOne 控制台生成 API Token） =====
# 控制台：https://console.cloud.tencent.com/edgeone/pages?tab=settings → API Token → 创建
EDGEONE_TOKEN=

# ===== 可选 =====
# 指定"今天"日期(YYYY-MM-DD)，默认取系统当天。一般无需设置。
# TODAY=2026-09-09
